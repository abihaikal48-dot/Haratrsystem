rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Live online presence tracking (who is currently browsing)
    match /online_presence/{presenceId} {
      allow list: if true;
      allow get, write: if isValidId(presenceId);
    }

    // Authenticated application users & verified roles
    match /app_users/{userId} {
      allow list: if true;
      allow get, write: if isValidId(userId);
    }

    // Outlets: Master cabang restoran
    match /outlets/{outletId} {
      allow list: if true;
      allow get, write: if isValidId(outletId);
    }

    // Kru: Personil gerai
    match /kru/{kruId} {
      allow list: if true;
      allow get, write: if isValidId(kruId);
    }

    // Penilaian Teori
    match /penilaian_teori/{teoriId} {
      allow list: if true;
      allow get, write: if isValidId(teoriId);
    }

    // Penilaian Praktik
    match /penilaian_praktik/{praktikId} {
      allow list: if true;
      allow get, write: if isValidId(praktikId);
    }

    // Penilaian Praktik Onboarding & RnD Produk
    match /penilaian_praktik_onboarding_produk/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    // Penilaian Lisan
    match /penilaian_lisan/{lisanId} {
      allow list: if true;
      allow get, write: if isValidId(lisanId);
    }

    // Observasi Lapangan
    match /observasi_lapangan/{observasiId} {
      allow list: if true;
      allow get, write: if isValidId(observasiId);
    }

    // Kartu Keluhan
    match /kartu_keluhan/{keluhanId} {
      allow list: if true;
      allow get, write: if isValidId(keluhanId);
    }

    // Rencana Training & TNA
    match /rencana_training/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /tna/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    // Coaching Log & Gap Analysis
    match /coaching_log/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /gap_analysis/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /talent_tracker/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    // Penugasan & Laporan Trainer
    match /penugasan_trainer/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /trainee_outlet/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /laporan_trainer/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    // Bank SOP & Bank Soal
    match /bank_sop/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /bank_soal/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /onboarding_progress/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /official_audits/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /official_rapor_kru/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    // Onboarding & Retraining Kru 3 Hari
    match /onboarding_batches/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /penilaian_onboarding_rnd/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /penilaian_praktik_onboarding_produk/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /jadwal_kunjungan/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    // Retraining & Kunjungan Cepat Trainer
    match /retraining_records/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /rapid_audits/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /settings/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    match /logs/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    // Hasil Ujian Kru & Exam Config dengan validasi ketat struktur
    match /hasil_ujian_mingguan/{id} {
      allow list: if true;
      allow get: if isValidId(id);
      allow create, update: if isValidId(id) &&
        request.resource.data.nama_kru is string &&
        request.resource.data.kode_outlet is string &&
        request.resource.data.skor_akhir_komposit is number &&
        request.resource.data.skor_akhir_komposit >= 0 &&
        request.resource.data.skor_akhir_komposit <= 100;
      allow delete: if isValidId(id);
    }
    match /exam_config/{id} {
      allow list: if true;
      allow get: if isValidId(id);
      allow create, update: if isValidId(id) &&
        request.resource.data.judul is string &&
        request.resource.data.durasi_menit is number &&
        request.resource.data.durasi_menit > 0;
      allow delete: if isValidId(id);
    }
    match /ojt_monitoring/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }
    match /attitude_hara/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }
    // Healthcheck / Connection test rule
    match /test/{id} {
      allow list: if true;
      allow get, write: if isValidId(id);
    }

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
